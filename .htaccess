# =============================================================================
# Melbourne Print & Publish — .htaccess
# =============================================================================

Options -Indexes
ServerSignature Off

# Unknown URLs must return a real 404 (Google treats a redirect-to-home
# as a "soft 404" and it burns crawl budget). 404.php also sends the
# 404 status itself, so the code is correct either way.
ErrorDocument 404 /404.php

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "(?i)\.(env|ini|log|sql|sh|bak|swp|conf|json|lock|md|zip|tar|gz|tgz|bz2|xz|rar|7z|old|orig|dist|backup|sqlite|db)$">
    Require all denied
</FilesMatch>

# Never serve the secrets file (it executes to nothing anyway, deny for safety)
<Files "config.secret.php">
    Require all denied
</Files>

# PHP drops extension-less "error_log" files next to scripts; they leak paths
<Files "error_log">
    Require all denied
</Files>

# -----------------------------------------------------------------------------
# Compression
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/ld+json application/xml application/rss+xml application/atom+xml
    AddOutputFilterByType DEFLATE image/svg+xml image/x-icon
    AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
    AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript application/x-javascript
    AddOutputFilterByType BROTLI_COMPRESS application/json application/ld+json application/xml application/rss+xml application/atom+xml
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# -----------------------------------------------------------------------------
# Browser caching
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType application/json "access plus 0 seconds"

    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"

    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"

    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType application/xml "access plus 1 hour"
    ExpiresByType text/xml "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "(?i)\.(ico|jpe?g|png|gif|webp|avif|svg|css|js|mjs|woff2?|ttf|otf|eot)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
        Header unset Pragma
    </FilesMatch>

    <FilesMatch "(?i)\.(html|htm)$">
        Header set Cache-Control "max-age=3600, public, must-revalidate"
    </FilesMatch>

    <FilesMatch "(?i)\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
    </FilesMatch>

    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    Header unset X-Powered-By
    Header unset Server
    Header unset ETag
</IfModule>

FileETag None

# -----------------------------------------------------------------------------
# Rewrite engine
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS on live
    RewriteCond %{HTTP_HOST} ^(?:www\.)?melbourneprintpublish\.com\.au$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

    # Force non-www on live
    RewriteCond %{HTTP_HOST} ^www\.melbourneprintpublish\.com\.au$ [NC]
    RewriteRule ^ https://melbourneprintpublish.com.au%{REQUEST_URI} [R=301,L,NE]

    # Admin passthrough: clean-URL rewrites must never touch /admin
    RewriteRule ^admin(/.*)?$ - [L]

    # Serve sitemap + robots dynamically (auto-updated from live blog data).
    # These fire even though the static files exist, so the same URLs stay live.
    RewriteRule ^sitemap_index\.xml$ sitemap.php [L]
    RewriteRule ^robots\.txt$ robots.php [L]

    # /index.php or /index -> /
    RewriteCond %{HTTP_HOST} ^(?:www\.)?melbourneprintpublish\.com\.au$ [NC]
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{THE_REQUEST} \s/index(?:\.php)?/?[?\s] [NC]
    RewriteRule ^ / [R=301,L,NE]

    # Strip .php extension -> /page/
    # POST requests will not redirect, so forms keep working
    RewriteCond %{HTTP_HOST} ^(?:www\.)?melbourneprintpublish\.com\.au$ [NC]
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{THE_REQUEST} \s/([^?\s]+)\.php([?\s]) [NC]
    RewriteRule ^ /%1/ [R=301,L,NE,QSA]

    # Add trailing slash only if related PHP file exists
    RewriteCond %{HTTP_HOST} ^(?:www\.)?melbourneprintpublish\.com\.au$ [NC]
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{REQUEST_URI} !/$
    RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.php -f
    RewriteRule ^(.+)$ /$1/ [R=301,L,NE,QSA]

    # Fix relative asset paths
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(?:.+/)?(assets|nc_assets)/(.+)$ /$1/$2 [L,NC]

    # Internally serve clean URLs from PHP files
    RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.php -f
    RewriteRule ^(.+?)/?$ $1.php [L]

    # Unknown URLs fall through to Apache's ErrorDocument 404 (set at the top
    # of this file). Do not redirect them to "/" — that is a soft 404.

</IfModule>