Wellness & Fitness Marketing\"\r\n                            }\r\n                        },\r\n                        {\r\n                            \"@type\": \"Offer\",\r\n                            \"itemOffered\": {\r\n                                \"@type\": \"Service\",\r\n                                \"name\": \"Cookbooks & Food Writing Marketing\"\r\n                            }\r\n                        },\r\n                        {\r\n                            \"@type\": \"Offer\",\r\n                            \"itemOffered\": {\r\n                                \"@type\": \"Service\",\r\n                                \"name\": \"Travel & Adventure Marketing\"\r\n                            }\r\n                        },\r\n                        {\r\n                            \"@type\": \"Offer\",\r\n                            \"itemOffered\": {\r\n                                \"@type\": \"Service\",\r\n                                \"name\": \"Religion & Spirituality Marketing\"\r\n                            }\r\n                        },\r\n                        {\r\n                            \"@type\": \"Offer\",\r\n                            \"itemOffered\": {\r\n                                \"@type\": \"Service\",\r\n                                \"name\": \"True Crime Marketing\"\r\n                            }\r\n                        }\r\n                    ]\r\n                },\r\n                {\r\n                    \"@type\": \"OfferCatalog\",\r\n                    \"name\": \"Specialised Categories\",\r\n                    \"itemListElement\": [{\r\n                            \"@type\": \"Offer\",\r\n                            \"itemOffered\": {\r\n                                \"@type\": \"Service\",\r\n                                \"name\": \"Academic & Educational Textbooks Marketing\"\r\n                            }\r\n                        },\r\n                        {\r\n                            \"@type\": \"Offer\",\r\n                            \"itemOffered\": {\r\n                                \"@type\": \"Service\",\r\n                                \"name\": \"Poetry Collections Marketing\"\r\n                            }\r\n                        },\r\n                        {\r\n                            \"@type\": \"Offer\",\r\n                            \"itemOffered\": {\r\n                                \"@type\": \"Service\",\r\n                                \"name\": \"Biography & History Marketing\"\r\n                            }\r\n                        },\r\n                        {\r\n                            \"@type\": \"Offer\",\r\n                            \"itemOffered\": {\r\n                                \"@type\": \"Service\",\r\n                                \"name\": \"Science & Technology Marketing\"\r\n                            }\r\n                        },\r\n                        {\r\n                            \"@type\": \"Offer\",\r\n                            \"itemOffered\": {\r\n                                \"@type\": \"Service\",\r\n                                \"name\": \"Parenting & Family Marketing\"\r\n                            }\r\n                        },\r\n                        {\r\n                            \"@type\": \"Offer\",\r\n                            \"itemOffered\": {\r\n                                \"@type\": \"Service\",\r\n                                \"name\": \"Art & Photography Books Marketing\"\r\n                            }\r\n                        },\r\n                        {\r\n                            \"@type\": \"Offer\",\r\n                            \"itemOffered\": {\r\n                                \"@type\": \"Service\",\r\n                                \"name\": \"How-To Guides & Instructional Manuals Marketing\"\r\n                            }\r\n                        },\r\n         