            "schemas": [
                "{\r\n        \"@context\": \"https://schema.org\",\r\n        \"@type\": \"AboutPage\",\r\n        \"name\": \"About Us\",\r\n        \"description\": \"We're Melbourne Print and Publish, a professional publishing company established in 2022 with a simple mission, make professional publishing accessible to every author who has a story worth telling. Since launching, we've helped over 500 authors transform their manuscripts into professionally published books they're genuinely proud of.\",\r\n        \"url\": \"https://melbourneprintpublish.com.au/about-us/\",\r\n        \"mainEntity\": {\r\n            \"@type\": \"Organization\",\r\n            \"name\": \"Melbourne Print and Publish\",\r\n            \"url\": \"https://melbourneprintpublish.com.au/\",\r\n            \"logo\": \"https://melbourneprintpublish.com.au/assets/images/logo.png\",\r\n            \"image\": \"https://melbourneprintpublish.com.au/assets/images/aboutimg.webp\",\r\n            \"description\": \"A professional publishing company established in 2022, helping over 500 authors transform their manuscripts into professionally published books. Melbourne-based team of experienced editors, designers, ghostwriters, and marketers.\",\r\n            \"foundingDate\": \"2022\",\r\n            \"foundingLocation\": {\r\n                \"@type\": \"Place\",\r\n                \"name\": \"Melbourne, Australia\"\r\n            },\r\n            \"address\": {\r\n                \"@type\": \"PostalAddress\",\r\n                \"streetAddress\": \"470 St Kilda Rd\",\r\n                \"addressLocality\": \"Melbourne\",\r\n                \"addressRegion\": \"VIC\",\r\n                \"postalCode\": \"3004\",\r\n                \"addressCountry\": \"AU\"\r\n            },\r\n            \"telephone\": \"(03) 4138 8706\",\r\n            \"email\": \"info@melbourneprintpublish.com.au\",\r\n            \"areaServed\": \"Global\",\r\n            \"numberOfEmployees\": {\r\n                \"@type\": \"QuantitativeValue\",\r\n                \"name\": \"Authors Published\",\r\n                \"value\": \"382+\"\r\n            },\r\n            \"aggregateRating\": {\r\n                \"@type\": \"AggregateRating\",\r\n                \"ratingValue\": \"3\",\r\n                \"bestRating\": \"5\",\r\n                \"ratingCount\": \"382\"\r\n            },\r\n            \"hasOfferCatalog\": {\r\n                \"@type\": \"OfferCatalog\",\r\n                \"name\": \"Publishing Services\",\r\n                \"itemListElement\": [{\r\n                        \"@type\": \"Offer\",\r\n                        \"itemOffered\": {\r\n                            \"@type\": \"Service\",\r\n                            \"name\": \"Book Editing\"\r\n                        }\r\n                    },\r\n                    {\r\n                        \"@type\": \"Offer\",\r\n                        \"itemOffered\": {\r\n                            \"@type\": \"Service\",\r\n                            \"name\": \"Book Cover Design\"\r\n                        }\r\n                    },\r\n                    {\r\n                        \"@type\": \"Offer\",\r\n                        \"itemOffered\": {\r\n                            \"@type\": \"Service\",\r\n                            \"name\": \"Book Formatting\"\r\n                        }\r\n                    },\r\n                    {\r\n                        \"@type\": \"Offer\",\r\n                        \"itemOffered\": {\r\n                            \"@type\": \"Service\",\r\n                            \"name\": \"Ghostwriting\"\r\n                        }\r\n                    },\r\n                    {\r\n                        \"@type\": \"Offer\",\r\n                        \"itemOffered\": {\r\n                            \"@type\": \"Service\",\r\n                            \"name\": \"Book Marketing\"\r\n                        }\r\n                    },\r\n                    {\r\n                        \"@type\": \"Offer\",\r\n                        \"itemOffered\": {\r\n                            \"@type\": \"Service\",\r\n                            \"name\": \"Book Publishing & Global Distribution\"\r\n                        }\r\n                    }\r\n                ]\r\n            },\r\n            \"sameAs\": [\r\n                \"https://www.facebook.com/melbourneprintandpublish/\",\r\n                \"https://www.instagram.com/melbourne_print_and_publish/\",\r\n                \"https://www.linkedin.com/company/melbourneprintandpublish\",\r\n                \"https://www.pinterest.com/melbournePandP/\",\r\n                \"https://x.com/melbournePandP\",\r\n                \"https://www.youtube.com/@melbourneprintandpublish\",\r\n                \"https://share.google/CUt8YHg5DZuZngGWA\"\r\n            ]\r\n        }\r\n    }"
