            "{\r\n        \"@context\": \"https://schema.org\",\r\n        \"@type\": \"LocalBusiness\",\r\n        \"name\": \"Melbourne Print and Publish\",\r\n        \"image\": \"https://melbourneprintpublish.com.au/assets/images/ProfessionalBook.webp\",\r\n        \"logo\": \"https://melbourneprintpublish.com.au/assets/images/logo.png\",\r\n        \"url\": \"https://melbourneprintpublish.com.au/marketing/\",\r\n        \"telephone\": \"(03) 4138 8706\",\r\n        \"email\": \"info@melbourneprintpublish.com.au\",\r\n        \"foundingDate\": \"2022\",\r\n        \"description\": \"Your book deserves to be discovered. Our expert book marketing services help authors across Melbourne reach their target readers through strategic campaigns that actually generate sales. We've helped countless authors launch successful books, build engaged audiences, and achieve genuine visibility on platforms like Amazon, social media, and beyond. Whether you're launching your first book or promoting your tenth, our experienced marketing team creates customised campaigns that fit your budget, genre, and goals — no cookie-cutter approaches, just results-driven strategies tailored to your specific book.\",\r\n        \"address\": {\r\n            \"@type\": \"PostalAddress\",\r\n            \"streetAddress\": \"470 St Kilda Rd\",\r\n            \"addressLocality\": \"Melbourne\",\r\n            \"addressRegion\": \"VIC\",\r\n            \"postalCode\": \"3004\",\r\n            \"addressCountry\": \"AU\"\r\n        },\r\n        \"geo\": {\r\n            \"@type\": \"GeoCoordinates\",\r\n            \"latitude\": -37.8407,\r\n            \"longitude\": 144.9785\r\n        },\r\n        \"sameAs\": [\r\n            \"https://share.google/CUt8YHg5DZuZngGWA\",\r\n            \"https://www.facebook.com/melbourneprintandpublish/\",\r\n            \"https://www.instagram.com/melbourne_print_and_publish/\",\r\n            \"https://www.linkedin.com/company/melbourneprintandpublish\",\r\n     