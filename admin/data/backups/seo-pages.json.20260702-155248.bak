            "{\r\n  \"@context\": \"https://schema.org\",\r\n  \"@type\": \"Organization\",\r\n  \"name\": \"Melbourne Print & Publish\",\r\n  \"url\": \"https://melbourneprintpublish.com.au/\",\r\n  \"logo\": \"https://melbourneprintpublish.com.au/assets/images/logo.png\",\r\n  \"image\": \"https://melbourneprintpublish.com.au/assets/images/ProfessionalBook.webp\",\r\n  \"description\": \"Transform your manuscript into a professionally published e-book with our expert self-publishing services. Since 2005, we've helped authors publish their books online with secure, streamlined processes. Our experienced publishing team follows industry-leading standards to deliver high-quality e-books that meet professional formatting, design, and distribution requirements. From manuscript to market, we handle the complete publishing journey.\",\r\n  \"foundingDate\": \"2022\",\r\n  \"telephone\": \"(03) 4138 8706\",\r\n  \"email\": \"info@melbourneprintpublish.com.au\",\r\n  \"address\": {\r\n    \"@type\": \"PostalAddress\",\r\n    \"streetAddress\": \"470 St Kilda Rd\",\r\n    \"addressLocality\": \"Melbourne\",\r\n    \"addressRegion\": \"VIC\",\r\n    \"postalCode\": \"3004\",\r\n    \"addressCountry\": \"AU\"\r\n  },\r\n  \"sameAs\": [\r\n    \"https://www.facebook.com/melbourneprintandpublish/\",\r\n    \"https://www.instagram.com/melbourne_print_and_publish/\",\r\n    \"https://www.linkedin.com/company/melbourneprintandpublish\",\r\n    \"https://www.pinterest.com/melbournePandP/\",\r\n    \"https://x.com/melbournePandP\",\r\n    \"https://www.youtube.com/@melbourneprintandpublish\",\r\n    \"https://share.google/CUt8YHg5DZuZngGWA\"\r\n  ],\r\n  \"aggregateRating\": {\r\n    \"@type\": \"AggregateRating\",\r\n    \"ratingValue\": \"4\",\r\n    \"bestRating\": \"5\",\r\n    \"ratingCount\": \"483\"\r\n  }\r\n}",
