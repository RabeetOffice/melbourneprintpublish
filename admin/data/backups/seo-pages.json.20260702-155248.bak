                 \"name\": \"Proofreading\",\r\n                        \"description\": \"Proofreading is the final quality check before publication. Our proofreaders catch typos, formatting inconsistencies, grammatical errors, and layout issues.\"\r\n                    }\r\n                },\r\n                {\r\n                    \"@type\": \"Offer\",\r\n                    \"itemOffered\": {\r\n                        \"@type\": \"Service\",\r\n                        \"name\": \"Manuscript Critique & Assessment\",\r\n                        \"description\": \"Our manuscript assessment service provides professional feedback on your work's strengths, weaknesses, and recommended next steps with a detailed editorial report.\"\r\n                    }\r\n                }\r\n            ]\r\n        },\r\n        \"areaServed\": {\r\n            \"@type\": \"City\",\r\n            \"name\": \"Melbourne\"\r\n        }\r\n    }",
                "{\r\n        \"@context\": \"https://schema.org\",\r\n        \"@type\": \"WebPage\",\r\n        \"name\": \"Professional Book Editing Services in Melbourne\",\r\n        \"url\": \"https://melbourneprintpublish.com.au/professional-editing/\",\r\n        \"description\": \"Transform your manuscript into a polished, publication-ready masterpiece with our expert book editing services. We've helped authors in Melbourne refine their work through comprehensive editing that addresses everything from story structure to grammar. Our experienced editors work across all genres, delivering professional results that lift your writing and engage readers. Whether you need developmental editing, copy editing, or proofreading, we provide the expertise your manuscript deserves.\",\r\n        \"inLanguage\": \"en-AU\",\r\n        \"isPartOf\": {\r\n            \"@type\": \"WebSite\",\r\n            \"name\": \"Melbourne Print & Publish\",\r\n            \"url\": \"https://melbourneprintpublish.com.au/\"\r\n        },\r\n        \"about\": {\r\n            \"@type\": \"LocalBusiness\",\r\n            \"@id\": \"https://melbourneprintpublish.com.au/#localbusiness\"\r\n        },\r\n        \"provider\": {\r\n            \"@type\": \"LocalBusiness\",\r\n            \"@id\": \"https://melbourneprintpublish.com.au/#localbusiness\"\r\n        },\r\n        \"primaryImageOfPage\": {\r\n            \"@type\": \"ImageObject\",\r\n            \"url\": \"https://melbourneprintpublish.com.au/assets/images/portrait-focus-man.webp\"\r\n        }\r\n    }",
